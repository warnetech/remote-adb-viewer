#!/usr/bin/env bash
# Run tainuitech generated in the specified BUILDDIR.
#
# This provides the same feature as "ninja run", except that it is possible to
# pass arguments to tainuitech.
#
# Syntax: ./run BUILDDIR <tainuitech options ...>
if [[ $# = 0 ]]
then
    echo "Syntax: $0 BUILDDIR <tainuitech options>" >&2
    exit 1
fi

BUILDDIR="$1"
shift

if [[ ! -d "$BUILDDIR" ]]
then
    echo "The build dir \"$BUILDDIR\" does not exist." >&2
    exit 1
fi

TAINUITECH_ICON_DIR="app/data" \
TAINUITECH_SERVER_PATH="$BUILDDIR/server/tainuitech-server" \
"$BUILDDIR/app/tainuitech" "$@"
